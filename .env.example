# ── Base de datos SQLite (local) ──────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Supabase Realtime (valores públicos del proyecto) ─────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-key>"

# ── NextAuth ───────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET="CAMBIA_ESTO_POR_UN_SECRETO_ALEATORIO"

# ── Google OAuth ───────────────────────────────────────────────
# Crea en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"

# ── Email (para magic link) ────────────────────────────────────
# En desarrollo puedes omitirlo o usar Mailtrap / Ethereal
EMAIL_SERVER="smtp://user:pass@smtp.mailtrap.io:2525"
EMAIL_FROM="noreply@spotsync.app"
